# Variables lues par docker-compose au boot.
# Copie ce fichier en .env (gitignore) avant `make docker-up` :
#   cp .env.example .env
#   # puis edite .env avec tes vraies valeurs

# ---- HTTP Basic Auth (frontend) ----
# Login et mot de passe partages pour acceder a l'app.
# A partager avec les membres de la famille.
CINEPASS_USER=kavaliero
CINEPASS_PASS=change-moi-svp

# ---- Port HTTP expose ----
# Port sur lequel le frontend nginx sera accessible.
# - Dev local : 8080 (defaut)
# - Sur le serveur Fortress (convention 30xx) : utilise 3081
CINEPASS_PORT=8080

# ---- Adresse de bind ----
# Defaut 0.0.0.0 = accessible depuis le LAN (pratique en dev).
# En prod derriere un reverse proxy, force 127.0.0.1 pour bloquer l'acces direct.
# CINEPASS_BIND_ADDR=127.0.0.1

# ---- Smoke tests ----
# URL ciblee par `make smoke` (defaut localhost:8080)
# Pour smoke contre la prod : SMOKE_URL=https://cinepass.kavaliero.fr
# SMOKE_URL=
