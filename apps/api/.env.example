# Copie ce fichier en .env et adapte les valeurs.

# SQLite path - relatif au dossier apps/api/
DATABASE_URL="file:./prisma/cinepass.db"

# Port HTTP du serveur Express
PORT=3001

# Origine CORS autorisée (frontend en dev)
CORS_ORIGIN="http://localhost:4321"

# Environnement
NODE_ENV=development

# TMDB API key (optionnelle) pour les posters
# Inscription gratuite : https://www.themoviedb.org/signup
# Puis : Settings -> API -> Request API key (Developer)
TMDB_API_KEY=
