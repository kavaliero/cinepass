// Cinépass - Prisma schema
// SQLite : pas d'enum natif, on stocke en string + validation côté app via zod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Un film de la watchlist.
/// `ageBracket` : "0-2" | "3-5" | "6-8" | "9-12" | "13-15" | "16-17" | "18+"
/// `status`     : "TO_WATCH" | "WATCHED" | "SKIP"
model Film {
  id         Int       @id @default(autoincrement())
  title      String
  year       Int
  director   String
  ageBracket String
  status     String    @default("TO_WATCH")
  notes      String?
  watchedAt  DateTime?
  // Metadata TMDB (renseigne via scripts/fetch-posters.mjs)
  tmdbId     Int?
  posterUrl  String?
  posterFetchedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([title, year])
  @@index([ageBracket])
  @@index([status])
  @@index([tmdbId])
}
